# ESPHome Solar Water Tank Sensor - Secrets Configuration
# 
# IMPORTANT: This file contains sensitive information!
# 1. Copy this file to secrets.yaml
# 2. Fill in your actual credentials
# 3. Add secrets.yaml to .gitignore (already done)
# 4. NEVER commit secrets.yaml to version control!

# ============================================================================
# PRIMARY WIFI NETWORK (Required)
# ============================================================================
wifi_ssid: 'your_primary_wifi_ssid'
wifi_password: 'your_primary_wifi_password'

# ============================================================================
# FALLBACK WIFI NETWORK (Optional)
# ============================================================================
# Uncomment and configure if you have a secondary network
# wifi_ssid_fallback: 'your_fallback_wifi_ssid'
# wifi_password_fallback: 'your_fallback_wifi_password'

# ============================================================================
# HOME ASSISTANT API ENCRYPTION (Required)
# ============================================================================
# Generate a new key with: esphome dashboard
# Or use an existing key from your Home Assistant ESPHome integration
api_encryption_key: 'your_base64_encoded_api_key_here'

# ============================================================================
# NOTES
# ============================================================================
# - All values must be quoted strings
# - Empty values should be: '' (empty string)
# - For the fallback network, leave commented out if not needed
# - The api_encryption_key must match what's configured in your Home Assistant
